rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Berkas sekolah: hanya akun pemilik yang boleh mengunggah/menghapus (maks. 10 MB, PDF/JPG/PNG).
    // Auditor membuka berkas lewat tautan unduhan yang tersimpan di dokumen Firestore (terlindungi aturan Firestore).
    match /bos/{uid}/{tahun}/{file} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|image/jpeg|image/png');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
