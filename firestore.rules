rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Petugas Inspektorat: ada dokumen dengan ID = email Google-nya di koleksi "auditors"
    function signedIn() { return request.auth != null; }
    function isAuditor() {
      return signedIn() && request.auth.token.email != null &&
        exists(/databases/$(database)/documents/auditors/$(request.auth.token.email.lower()));
    }

    // Daftar auditor: hanya dibaca oleh pemilik emailnya; diubah lewat Firebase Console saja
    match /auditors/{email} {
      allow get: if signedIn() && request.auth.token.email.lower() == email;
      allow list, write: if false;
    }

    // Profil sekolah: milik akun Google sekolah itu sendiri; auditor boleh membaca semua
    match /sekolah/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAuditor());
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nama','npsn','kecamatan','kepsek','email'])
        && request.resource.data.nama is string && request.resource.data.nama.size() < 150
        && request.resource.data.npsn is string && request.resource.data.npsn.size() < 20;
      allow delete: if false;
    }

    // Dokumen: sekolah hanya membuat/membaca/menghapus miliknya; hanya auditor yang menilai
    match /dokumen/{id} {
      allow read: if signedIn() && (resource.data.sekolahId == request.auth.uid || isAuditor());
      allow create: if signedIn()
        && request.resource.data.sekolahId == request.auth.uid
        && request.resource.data.status == 'Menunggu Review'
        && request.resource.data.catatan == ''
        && request.resource.data.fase in ['Perencanaan','Pelaksanaan','Pertanggungjawaban']
        && request.resource.data.path.matches('bos/' + request.auth.uid + '/.*');
      allow update: if isAuditor()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status','catatan','reviewer','direview'])
        && request.resource.data.status in ['Menunggu Review','Sesuai','Perlu Perbaikan'];
      allow delete: if signedIn() && resource.data.sekolahId == request.auth.uid
        && resource.data.status != 'Sesuai';
    }

    match /{document=**} { allow read, write: if false; }
  }
}
